# ---- Core ---------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
NEXUS_SECRET=replace-with-a-long-random-value
PORT=8000
HOST=0.0.0.0
NEXUS_DATA_DIR=./data
# Preview/embedding compatibility. Set to 0 in production to force
# cookie/bearer-only sessions (disables the query-string session fallback).
NEXUS_ALLOW_QUERY_SESSION=1
# Set to 1 temporarily to log request method/path/header NAMES (never values).
# NEXUS_DEBUG=1

# ---- Real conversational AI (missing credentials = clear error, NOT chat fallback) ----
# NEXUS_AI_PROVIDER=openai_compatible
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# NEXUS_AI_MODEL=gpt-4o-mini
# NEXUS_AI_TIMEOUT=30
# For Google Gemini instead (independent of OpenAI billing):
# NEXUS_AI_PROVIDER=gemini
# GEMINI_API_KEY=
# NEXUS_AI_MODEL=gemini-3.5-flash-lite
# Gemini endpoint is automatically https://generativelanguage.googleapis.com/v1beta
# Google free-tier model/project quotas apply; no unlimited-access claim.
# For a real local model server instead:
# NEXUS_AI_PROVIDER=ollama
# NEXUS_AI_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---- Image generation (independent; chat does NOT imply images are supported) ----
# NEXUS_IMAGE_PROVIDER=openai_compatible
# NEXUS_IMAGE_API_KEY=        (may fall back to OPENAI_API_KEY if provider explicitly selected)
# NEXUS_IMAGE_BASE_URL=https://api.openai.com/v1
# NEXUS_IMAGE_MODEL=gpt-image-1
# NEXUS_IMAGE_TIMEOUT=90

# ---- Real web search (without this, explicitly curated documentation only) ----
# NEXUS_SEARCH_PROVIDER=tavily
# NEXUS_SEARCH_API_KEY=
# NEXUS_SEARCH_BASE_URL=https://api.tavily.com
# Alternative: NEXUS_SEARCH_PROVIDER=searxng and your own instance URL.

# ---- Stripe (optional - required for real checkout) ---------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# ---- MQTT bridge (optional) ---------------------------------------------
# NEXUS_MQTT_BROKER=mqtt.example.com
# NEXUS_MQTT_PORT=1883
# NEXUS_MQTT_TOPIC=nexus/devices/#
# NEXUS_MQTT_USER=
# NEXUS_MQTT_PASSWORD=

# ---- First administrator bootstrap --------------------------------------
# NEXUS_ADMIN_EMAIL=admin@example.com
# NEXUS_ADMIN_PASSWORD=   (prefer the interactive getpass prompt)
